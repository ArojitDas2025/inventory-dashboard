# Metabase Configuration
# Copy this file to .env and fill in your values

# Your Metabase Cloud URL (e.g., https://yourcompany.metabaseapp.com)
METABASE_URL=https://your-instance.metabaseapp.com

# Your Metabase login credentials
METABASE_USERNAME=your-email@company.com
METABASE_PASSWORD=your-password

# Metabase Question IDs
# Find these by opening the question in Metabase and looking at the URL
# e.g., https://yourcompany.metabaseapp.com/question/123 -> Question ID is 123
QUESTION_ID_INVENTORY=123
QUESTION_ID_CONSUMPTION=456
QUESTION_ID_INWARDED=789

# Server port (optional, defaults to 3000)
PORT=3000
